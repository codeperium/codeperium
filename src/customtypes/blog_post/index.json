{
	"format": "page",
	"id": "blog_post",
	"label": "Blog Post",
	"repeatable": true,
	"status": true,
	"json": {
		"Main": {
			"uid": {
				"type": "UID",
				"config": {
					"label": "UID"
				}
			},
			"date": {
				"type": "Date",
				"config": {
					"label": "date",
					"placeholder": ""
				}
			},
			"title": {
				"type": "Text",
				"config": {
					"label": "Title",
					"placeholder": ""
				}
			},
			"tags": {
				"type": "Group",
				"config": {
					"label": "tags",
					"repeat": true,
					"fields": {
						"tag": {
							"type": "Link",
							"config": {
								"label": "tag",
								"select": "document",
								"customtypes": ["tags"]
							}
						}
					}
				}
			},
			"header_image": {
				"type": "Image",
				"config": {
					"label": "Header image",
					"constraint": {},
					"thumbnails": []
				}
			},
			"short_description": {
				"type": "StructuredText",
				"config": {
					"label": "Short description",
					"placeholder": "",
					"allowTargetBlank": true,
					"single": "paragraph"
				}
			},
			"slices": {
				"type": "Slices",
				"fieldset": "Slice Zone",
				"config": {
					"choices": {
						"code_block": {
							"type": "SharedSlice"
						}
					}
				}
			}
		},
		"SEO & Metadata": {
			"meta_title": {
				"config": {
					"label": "Meta Title",
					"placeholder": "A title of the page used for social media and search engines"
				},
				"type": "Text"
			},
			"meta_description": {
				"config": {
					"label": "Meta Description",
					"placeholder": "A brief summary of the page"
				},
				"type": "Text"
			},
			"meta_image": {
				"config": {
					"constraint": {
						"height": 1260,
						"width": 2400
					},
					"label": "Meta Image",
					"thumbnails": []
				},
				"type": "Image"
			}
		}
	}
}
